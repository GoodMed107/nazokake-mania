# これを .env にコピーして、あなたのキーを入れてください（.env は他人に渡さない）
# Anthropic のAPIキー。https://console.anthropic.com/ で取得。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 使うモデル（任意）。速度・コスト重視なら claude-haiku-4-5 / claude-sonnet-5
# NAZOKAKE_MODEL=claude-opus-5

# 進行の秒数など（任意）
# NAZOKAKE_ROUNDS=5
# NAZOKAKE_THINK=90
# NAZOKAKE_VOTE=45
# PORT=8080
