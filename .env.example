# これを .env にコピーして、あなたのキーを入れてください（.env は他人に渡さない）
# Google Gemini のAPIキー。https://aistudio.google.com/apikey で発行（無料枠あり）。
GEMINI_API_KEY=AIza-xxxxxxxx

# 使うモデル（任意）。無料枠・高速なら gemini-2.0-flash
# NAZOKAKE_MODEL=gemini-2.0-flash

# 進行の秒数など（任意）
# NAZOKAKE_ROUNDS=5
# NAZOKAKE_THINK=90
# NAZOKAKE_VOTE=45
# PORT=8080
